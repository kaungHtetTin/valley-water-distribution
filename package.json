        "lodash": "^4.17.19",
        "postcss": "^8.1.14",
        "vite": "^8.3.1"
    },
    "overrides": {
        "app-builder-lib": {
            "minimatch": "^11.0.1"
        },
        "@electron/universal": {
            "minimatch": "^11.0.1"
        }
    },
    "dependencies": {
        "@capacitor/android": "^8.6.0",
        "@capacitor/core": "^8.6.0",
        "@vitejs/plugin-react": "^6.1.1",
