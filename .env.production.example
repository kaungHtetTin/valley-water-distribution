APP_NAME="Valley Water Distribution"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://valley.example.com
APP_TIMEZONE=Asia/Yangon

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=valley
DB_USERNAME=valley_app
DB_PASSWORD=

VALLEY_ADMIN_NAME="Business Owner"
VALLEY_ADMIN_EMAIL=
VALLEY_ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VALLEY_DEMO_ENDPOINTS=false
VALLEY_SLOW_QUERY_MS=250
VALLEY_BACKUP_DIRECTORY=/srv/valley/shared/backups
VALLEY_BACKUP_RETENTION_DAYS=30
PROFILE_PHOTOS_PATH=/srv/valley/shared/profile-photos
PROFILE_PHOTOS_URL=uploads/profile-photos
MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://valley.example.com/api/auth/google/callback
