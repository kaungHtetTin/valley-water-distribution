<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">
        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:importantForAccessibility="no"
            android:src="@drawable/valley_splash_logo" />
        <TextView
            android:id="@+id/connection_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="#172033"
            android:textSize="22sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/connection_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#087E9C" />
        <TextView
            android:id="@+id/connection_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="#596B7B"
            android:textSize="16sp" />
        <Button
            android:id="@+id/connection_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#087E9C"
            android:minHeight="48dp"
            android:text="@string/connection_retry"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
